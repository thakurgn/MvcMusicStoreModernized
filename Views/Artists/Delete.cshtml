@model MvcMusicStoreModernized.Models.Artist

@{
    ViewData["Title"] = "Delete Artist";
    var hasAlbums = Model.Albums != null && Model.Albums.Count > 0;
}

<h1>Delete Artist</h1>

<h3>Are you sure you want to delete this artist?</h3>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (hasAlbums)
{
    <div class="alert alert-warning">
        This artist cannot be deleted because albums are linked to it.
    </div>
}

<div>
    <h4>Artist</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Artist Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Linked Albums</dt>
        <dd class="col-sm-10">@(Model.Albums?.Count ?? 0)</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.ArtistId">
        <input type="hidden" asp-for="ArtistId" />

        @if (!hasAlbums)
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>