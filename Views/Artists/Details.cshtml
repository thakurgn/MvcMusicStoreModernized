@model MvcMusicStoreModernized.Models.Artist

@{
    ViewData["Title"] = "Artist Details";
}

<h1>Artist Details</h1>

<div>
    <h4>Artist</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Artist Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Linked Albums</dt>
        <dd class="col-sm-10">@(Model.Albums?.Count ?? 0)</dd>
    </dl>
</div>

@if (Model.Albums != null && Model.Albums.Count > 0)
{
    <h5>Albums</h5>

    <ul>
        @foreach (var album in Model.Albums)
        {
            <li>@album.Title</li>
        }
    </ul>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.ArtistId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>