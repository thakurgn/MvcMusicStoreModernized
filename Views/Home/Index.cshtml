@model IEnumerable<MvcMusicStoreModernized.Models.Album>

@{
    ViewData["Title"] = "ASP.NET MVC Music Store";
}

<div id="promotion">
</div>

<h3><em>Fresh</em> off the grill</h3>

<ul id="album-list">
    @foreach (var album in Model)
    {
        var imageUrl = string.IsNullOrWhiteSpace(album.AlbumArtUrl)
        ? Url.Content("~/Content/Images/placeholder.gif")
        : album.AlbumArtUrl;

        <li>
            <a asp-controller="Store" asp-action="Details" asp-route-id="@album.AlbumId">
                <img alt="@album.Title" src="@imageUrl" />
                <span>@album.Title</span>
            </a>
        </li>
    }
</ul>