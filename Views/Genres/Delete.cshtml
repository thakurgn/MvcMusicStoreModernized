@model MvcMusicStoreModernized.Models.Genre

@{
    ViewData["Title"] = "Delete Genre";
    var hasAlbums = Model.Albums != null && Model.Albums.Count > 0;
}

<h1>Delete Genre</h1>

<h3>Are you sure you want to delete this genre?</h3>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (hasAlbums)
{
    <div class="alert alert-warning">
        This genre cannot be deleted because albums are linked to it.
    </div>
}

<dl class="row">
    <dt class="col-sm-2">Genre Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Linked Albums</dt>
    <dd class="col-sm-10">@(Model.Albums?.Count ?? 0)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.GenreId">
    <input type="hidden" asp-for="GenreId" />

    @if (!hasAlbums)
    {
        <input type="submit" value="Delete" class="btn btn-danger" />
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>