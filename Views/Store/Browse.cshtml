@model MvcMusicStoreModernized.Models.Genre

@{
    ViewData["Title"] = "Browse Albums";
}

<div class="genre">
    <h3><em>@Model.Name</em> Albums</h3>

    <ul id="album-list">
        @foreach (var album in Model.Albums)
        {
            var imageUrl = string.IsNullOrWhiteSpace(album.AlbumArtUrl)
            ? Url.Content("~/Content/Images/placeholder.gif")
            : album.AlbumArtUrl;

            <li>
                <a asp-action="Details" asp-route-id="@album.AlbumId">
                    <img alt="@album.Title" src="@imageUrl" />
                    <span>@album.Title</span>
                </a>
            </li>
        }
    </ul>
</div>