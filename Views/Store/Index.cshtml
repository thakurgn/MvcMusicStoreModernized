@model IEnumerable<MvcMusicStoreModernized.Models.Genre>

@{
    ViewData["Title"] = "Store";
}

<h3>Browse Genres</h3>

<p>Select from @Model.Count() genres:</p>

<ul>
    @foreach (var genre in Model)
    {
        <li>
            <a asp-action="Browse" asp-route-genre="@genre.Name">@genre.Name</a>
        </li>
    }
</ul>