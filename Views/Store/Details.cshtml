@model MvcMusicStoreModernized.Models.Album

@{
    ViewData["Title"] = "Album - " + Model.Title;
    var imageUrl = string.IsNullOrWhiteSpace(Model.AlbumArtUrl)
        ? Url.Content("~/Content/Images/placeholder.gif")
        : Model.AlbumArtUrl;
}

<h2>@Model.Title</h2>

<p>
    <img alt="@Model.Title" src="@imageUrl" />
</p>

<div id="album-details">
    <p>
        <em>Genre:</em>
        @Model.Genre?.Name
    </p>
    <p>
        <em>Artist:</em>
        @Model.Artist?.Name
    </p>
    <p>
        <em>Price:</em>
        @String.Format("{0:F}", Model.Price)
    </p>
    <p class="button">
        <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@Model.AlbumId">
            Add to cart
        </a>
    </p>
</div>