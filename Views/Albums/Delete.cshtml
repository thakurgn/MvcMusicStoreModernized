@model MvcMusicStoreModernized.Models.Album

@{
    ViewData["Title"] = "Delete Album";
}

<h1>Delete Album</h1>

<h3>Are you sure you want to delete this album?</h3>

<div>
    <h4>Album</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Artist</dt>
        <dd class="col-sm-10">@Model.Artist?.Name</dd>

        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@Model.Genre?.Name</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <dt class="col-sm-2">Album Art URL</dt>
        <dd class="col-sm-10">@Model.AlbumArtUrl</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.AlbumId">
        <input type="hidden" asp-for="AlbumId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>